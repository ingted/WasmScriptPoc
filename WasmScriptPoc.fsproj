<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <Import Project="..\Bolero\src\Bolero.Build\Bolero.Build.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <BoleroTaskAssemblyPath>M:\git\Bolero\src\Bolero.Build\bin\Debug\netstandard2.0\Bolero.Build.dll</BoleroTaskAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bolero.FCS.Build - Copy\src\Compiler\Bolero.FSharp.Compiler.Service.fsproj" />
    <ProjectReference Include="..\Bolero\src\Bolero.Html\Bolero.Html.fsproj" />
    <ProjectReference Include="..\Bolero\src\Bolero\Bolero.fsproj" />
    <ProjectReference Include="..\Bolero.FCS.Build - Copy\src\FSharp.DependencyManager.Nuget\FSharp.DependencyManager.Nuget.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="linker.xml" />
    <Content Include="linker.xml" />
    <BlazorLinkerDescriptor Include="linker.xml" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="..\Bolero\src\Bolero.Build\Bolero.Build.targets" />
  <Import Project="..\Bolero\src\Bolero\Bolero.targets" />
  
  <!-- Post-build target to copy refs to wwwroot/refs -->
  <Target Name="CopyRefs" AfterTargets="Build">
    <ItemGroup>
      <RefAssemblies Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RefAssemblies)" DestinationFolder="wwwroot/refs" />
  </Target>
</Project>